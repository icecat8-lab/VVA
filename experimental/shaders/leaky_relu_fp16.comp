#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0, std430) readonly buffer InputTensor { float16_t in_data[]; };
layout(binding = 1, std430) writeonly buffer OutputTensor{ float16_t out_data[]; };

layout(push_constant) uniform PushConstants {
    int total_elements;
    float alpha; 
} params;

void main() {
    int idx = int(gl_GlobalInvocationID.x);
    if (idx >= params.total_elements) return;

    float16_t val = in_data[idx];
    float16_t alpha_fp16 = float16_t(params.alpha);
    
    out_data[idx] = (val > float16_t(0.0)) ? val : val * alpha_fp16;
}
