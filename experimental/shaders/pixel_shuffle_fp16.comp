#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, std430) readonly buffer InputTensor { float16_t in_data[]; };
layout(binding = 1, std430) writeonly buffer OutputTensor{ float16_t out_data[]; };

layout(push_constant) uniform PushConstants {
    int in_channels;
    int in_width;
    int in_height;
    int upscale_factor;
} params;

void main() {
    ivec2 out_pos = ivec2(gl_GlobalInvocationID.xy);
    int oc = int(gl_GlobalInvocationID.z);

    int out_width = params.in_width * params.upscale_factor;
    int out_height = params.in_height * params.upscale_factor;

    if (out_pos.x >= out_width || out_pos.y >= out_height) return;

    int in_x = out_pos.x / params.upscale_factor;
    int in_y = out_pos.y / params.upscale_factor;
    
    int sub_x = out_pos.x % params.upscale_factor;
    int sub_y = out_pos.y % params.upscale_factor;

    int ic = (oc * params.upscale_factor + sub_y) * params.upscale_factor + sub_x;

    int in_idx = (ic * params.in_height + in_y) * params.in_width + in_x;
    int out_idx = (oc * out_height + out_pos.y) * out_width + out_pos.x;

    out_data[out_idx] = in_data[in_idx];
}
