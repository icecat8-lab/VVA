#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0, std430) readonly buffer Input1Tensor { float16_t in1_data[]; };
layout(binding = 1, std430) readonly buffer Input2Tensor { float16_t in2_data[]; };
layout(binding = 2, std430) writeonly buffer OutputTensor{ float16_t out_data[]; };

layout(push_constant) uniform PushConstants {
    int total_elements;
} params;

void main() {
    int idx = int(gl_GlobalInvocationID.x);
    if (idx >= params.total_elements) return;
    
    out_data[idx] = in1_data[idx] + in2_data[idx];
}
